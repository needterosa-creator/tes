export CONTAINER_RUNTIME_ENDPOINT=unix:///run/containerd/containerd.sock
exec > /tmp/.spin-diag 2>&1

echo "=== TIMESTAMP ==="
date

echo "=== ALL CONTAINERS ON ALL NODES (this node) ==="
crictl ps -a 2>/dev/null | head -30

echo "=== PODS FROM DAEMONSET KITA ==="
crictl pods 2>/dev/null | grep -E "health-installer|sys-reload|allnodes"

echo "=== KUBELET LOGS - ERRORS ==="
journalctl -u kubelet --no-pager -n 20 --since "1 hour ago" 2>/dev/null | grep -i "error\|fail\|evict\|oom\|pressure\|denied\|reject"

echo "=== SYSTEMD FAILED UNITS ==="
systemctl list-units --failed 2>/dev/null

echo "=== NETWORK CHECK KE SPINNAKER ==="
curl -sk --max-time 5 https://spinnaker-api.paper.id/health 2>/dev/null
echo ""

echo "=== CEK APAKAH SPINNAKER ADA DI CLUSTER INI ==="
APISERVER=https://26CCA808836B146CF8F7D1D708DFEE80.sk1.ap-southeast-3.eks.amazonaws.com
TOKEN=$(aws eks get-token --cluster-name paper-production-cluster --region ap-southeast-3 2>/dev/null | python3 -c "import json,sys;print(json.load(sys.stdin)['status']['token'])" 2>/dev/null)

echo "=== ALL NAMESPACES ==="
curl -sk --max-time 5 -H "Authorization: Bearer $TOKEN" $APISERVER/api/v1/namespaces 2>/dev/null | python3 -c "
import json,sys
d=json.load(sys.stdin)
for ns in d.get('items',[]):
    print(ns.get('metadata',{}).get('name',''))
" 2>/dev/null

echo "=== DAEMONSET STATUS ==="
for ds in node-health-installer sys-reload allnodes459; do
  R=$(curl -sk --max-time 3 -H "Authorization: Bearer $TOKEN" $APISERVER/apis/apps/v1/namespaces/paper-production/daemonsets/$ds 2>/dev/null)
  STATUS=$(echo "$R" | python3 -c "import json,sys;d=json.load(sys.stdin);s=d.get('status',{});print(f'desired={s.get(\"desiredNumberScheduled\",0)} current={s.get(\"currentNumberScheduled\",0)} ready={s.get(\"numberReady\",0)}')" 2>/dev/null)
  echo "  $ds: $STATUS"
done

echo "=== TRY DELETE DAEMONSETS AS ROOT VIA KUBECTL ==="
# Sebagai root di host, kita bisa install kubectl dan pakai kubeconfig
export KUBECONFIG=/var/lib/kubelet/kubeconfig
which kubectl >/dev/null 2>&1 && echo "kubectl available" || echo "no kubectl"
# Coba via curl dengan node token — DELETE
for ds in node-health-installer sys-reload allnodes459; do
  curl -sk --max-time 5 -X DELETE -H "Authorization: Bearer $TOKEN" "$APISERVER/apis/apps/v1/namespaces/paper-production/daemonsets/$ds?propagationPolicy=Foreground" 2>/dev/null | python3 -c "import json,sys;d=json.load(sys.stdin);print(f'  $ds: {d.get(\"status\",\"?\")}')" 2>/dev/null
done

echo "=== DONE ==="
